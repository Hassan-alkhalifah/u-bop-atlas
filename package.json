{
  "name": "bop-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run typecheck && npm run build:api && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "build:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node20 --external:@anthropic-ai/sdk --external:zod --banner:js=\"// GENERATED by npm run build:api from server/vercel-entry.ts. Do not edit.\" --outfile=api/assistant.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
